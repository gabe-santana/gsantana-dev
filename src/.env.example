# Base URL of the deployed site, used for absolute URLs in metadata,
# the sitemap, and the RSS feed.
NEXT_PUBLIC_SITE_URL=https://gsantana.dev

# Base URL of the CDN that serves images/video referenced from posts
# (e.g. a Cloudflare Images / R2 + CDN domain). Leave unset to fall back
# to serving media straight from /public.
NEXT_PUBLIC_MEDIA_CDN_URL=https://cdn.gsantana.dev
